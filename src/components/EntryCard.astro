---
import Icon from './Icon.astro';
import LastUpdated from './LastUpdated.astro';

interface MetaItem {
  label: string;
  value: string;
}

interface SourceItem {
  title: string;
  url: string;
}

interface Props {
  title: string;
  meta?: MetaItem[];
  details?: string[];
  badge?: string;
  source?: SourceItem;
  updated?: string | null;
}

const {
  title,
  meta = [],
  details = [],
  badge,
  source,
  updated = null,
} = Astro.props;
---

<article class="card">
  {badge && <div class="card__meta"><span class="badge">{badge}</span></div>}

  <h3 class="card__title">{title}</h3>

  {
    meta.length > 0 && (
      <dl class="detail-list">
        {meta.map((item) => (
          <div class="detail-list__item">
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  {
    details.length > 0 && (
      <ul>
        {details.map((detail) => <li>{detail}</li>)}
      </ul>
    )
  }

  {
    source && (
      <p class="card__source">
        Source: <a href={source.url} rel="noopener noreferrer" target="_blank">{source.title}<Icon name="arrowUpRight" size={12} /></a>
      </p>
    )
  }

  <LastUpdated updated={updated} />
</article>
