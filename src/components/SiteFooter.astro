---
import Icon from './Icon.astro';
import LogoPair from './LogoPair.astro';
import site from '../data/site.json';

const base = import.meta.env.BASE_URL;
const announcementsHref = `${base}announcements/`;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="footer-brand">
      <LogoPair height={32} decorative />
      <div>
        <p class="footer-title"><strong>{site.shortName}</strong></p>
        <p>{site.unit} · {site.location}</p>
        <p class="footer-detail">
          <Icon name="pin" size={14} />
          <span>
            {site.addressLabel}: {site.address}
          </span>
        </p>
        <p class="footer-detail">
          <Icon name="mail" size={14} />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </div>
    <div class="footer-links">
      <p>Public information only. Details are subject to change.</p>
      <p><a href={announcementsHref}>View advisories and announcements</a></p>
      <p class="footer-source">Address from a CHO public notice; email from the City of Valencia department directory.</p>
    </div>
  </div>
</footer>
