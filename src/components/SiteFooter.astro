---
import LogoPair from './LogoPair.astro';
import site from '../data/site.json';

const base = import.meta.env.BASE_URL;
const announcementsHref = `${base}announcements/`;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="footer-brand">
      <LogoPair height={28} decorative />
      <div>
        <p><strong>{site.name}</strong></p>
        <p>{site.location}</p>
      </div>
    </div>
    <div>
      <p>Public information only. Details are subject to change.</p>
      <p><a href={announcementsHref}>View advisories and announcements</a></p>
    </div>
  </div>
</footer>
