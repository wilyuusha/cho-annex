---
import LogoPair from './LogoPair.astro';
import site from '../data/site.json';

const base = import.meta.env.BASE_URL;
const basePath = base.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(basePath, '').replace(/\/+$/, '') || '/';

const navItems = [
  { label: 'Home', slug: '/' },
  { label: 'Schedules', slug: '/schedules' },
  { label: 'Services', slug: '/services' },
  { label: 'Directory', slug: '/directory' },
  { label: 'Announcements', slug: '/announcements' },
];

const hrefFor = (slug: string) =>
  slug === '/' ? base : `${base}${slug.replace(/^\//, '')}/`;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={hrefFor('/')} aria-label={`${site.name} home`}>
      <LogoPair height={36} loading="eager" />
      <span class="brand__text">
        <span class="brand__name">{site.shortName}</span>
        <span class="brand__location">{site.location}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {
          navItems.map((item) => {
            const isActive = currentPath === item.slug;
            return (
              <li>
                <a
                  class="site-nav__link"
                  href={hrefFor(item.slug)}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
