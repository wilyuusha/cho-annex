---
import { Image } from 'astro:assets';
import choLogo from '../images/cho_logo_logo.png';
import lguLogo from '../images/lgu_valencia_logo.png';

interface Props {
  height?: number;
  decorative?: boolean;
  loading?: 'lazy' | 'eager';
}

const { height = 36, decorative = false, loading = 'lazy' } = Astro.props;
const altText = (text: string) => (decorative ? '' : text);
---

<span class="logo-pair">
  <Image
    src={choLogo}
    alt={altText('City Health Office logo')}
    height={height}
    loading={loading}
    aria-hidden={decorative ? 'true' : undefined}
    class="logo-pair__image"
  />
  <Image
    src={lguLogo}
    alt={altText('Valencia City LGU logo')}
    height={height}
    loading={loading}
    aria-hidden={decorative ? 'true' : undefined}
    class="logo-pair__image"
  />
</span>
