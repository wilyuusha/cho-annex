---
import Icon from './Icon.astro';
import LastUpdated from './LastUpdated.astro';

interface ScheduleRow {
  title: string;
  when: string;
  notes: string[];
  badge?: string;
  source?: { title: string; url: string };
  updated?: string | null;
}

interface Props {
  rows: ScheduleRow[];
}

const { rows } = Astro.props;
---

<div class="schedule-table-wrap">
  <table class="schedule-table">
    <thead>
      <tr>
        <th scope="col">Service</th>
        <th scope="col">When</th>
        <th scope="col">Details</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">
              <span class="schedule-table__service">
                {row.badge && <span class="badge">{row.badge}</span>}
                <span class="schedule-table__title">{row.title}</span>
                {row.source && (
                  <span class="schedule-table__source">
                    Source:{' '}
                    <a href={row.source.url} rel="noopener noreferrer" target="_blank">
                      {row.source.title}
                      <Icon name="arrowUpRight" size={12} />
                    </a>
                  </span>
                )}
              </span>
            </th>
            <td data-label="When">
              <strong class="schedule-table__when">{row.when}</strong>
            </td>
            <td data-label="Details">
              {row.notes.length > 0 ? (
                <ul class="schedule-table__notes">
                  {row.notes.map((note) => <li>{note}</li>)}
                </ul>
              ) : (
                <span class="schedule-table__empty">No additional details.</span>
              )}
              <LastUpdated updated={row.updated} />
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
