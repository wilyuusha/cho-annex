---
import BaseLayout from '../layouts/BaseLayout.astro';

const homeHref = `${import.meta.env.BASE_URL}`;
---

<BaseLayout title="Page not found" description="The requested page could not be found.">
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="lead">The page you were looking for is not available on this site.</p>
    </header>
    <p><a class="button" href={homeHref}>Return to the home page</a></p>
  </div>
</BaseLayout>
