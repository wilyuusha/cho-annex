---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServicesView from '../../components/mui/views/ServicesView';
import servicesData from '../../data/services.json';
import site from '../../data/site.json';
import type { ServicesData } from '../../data/types';
import type { SiteInfo } from '../../components/mui/types';

const services = servicesData as ServicesData;
---

<BaseLayout
  title="Services"
  description="Browse CHO Annex services by category, including clinical services, certificates, permits, environmental health, and more."
>
  <ServicesView services={services} site={site as SiteInfo} base={import.meta.env.BASE_URL} />
</BaseLayout>
