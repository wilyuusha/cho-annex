---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeView from '../components/mui/views/HomeView';
import announcementsData from '../data/announcements.json';
import doctorsData from '../data/doctors.json';
import schedulesData from '../data/schedules.json';
import site from '../data/site.json';
import type { AnnouncementsData, DoctorsData, SchedulesData } from '../data/types';
import heroCarousel1 from '../images/hero-carousel-img1.jpeg';
import heroCarousel2 from '../images/hero-carousel-img2.jpeg';
import heroCarousel3 from '../images/hero-carousel-img3.jpeg';
import heroCarousel4 from '../images/hero-carousel-img4.jpeg';
import heroCarousel5 from '../images/hero-carousel-img5.jpeg';
import heroCarousel6 from '../images/hero-carousel-img6.jpeg';
import heroCarousel7 from '../images/hero-carousel-img7.jpeg';
import layoutPlaceholder from '../images/directory-layout-placeholder.svg';

const heroImages = [
  heroCarousel1,
  heroCarousel2,
  heroCarousel3,
  heroCarousel4,
  heroCarousel5,
  heroCarousel6,
  heroCarousel7,
];

const heroSlides = await Promise.all(
  heroImages.map((image) => getImage({ src: image, width: 1280 })),
);
const heroImageUrls = heroSlides.map((slide) => slide.src);

const announcements = announcementsData as AnnouncementsData;
const doctors = doctorsData as DoctorsData;
const schedules = schedulesData as SchedulesData;

const latestAnnouncement = [...announcements.entries]
  .sort((a, b) => b.published.localeCompare(a.published))[0];

const homeHours = [
  ...schedules.regularHours.map((entry) => ({ entry, badge: 'CHO Annex' })),
  ...schedules.abtc.map((entry) => ({ entry, badge: 'ABTC' })),
].map(({ entry, badge }) => ({
  title: entry.title,
  when: entry.when || 'To be confirmed',
  notes: entry.notes ?? [],
  badge,
  source: entry.source,
  updated: entry.updated,
}));
---

<BaseLayout title="Home">
  <HomeView
    site={site}
    heroImages={heroImageUrls}
    latestAnnouncement={latestAnnouncement ?? null}
    hours={homeHours}
    doctors={doctors}
    schedulesLastUpdated={schedules.lastUpdated}
    announcementsLastUpdated={announcements.lastUpdated}
    layoutPlaceholder={layoutPlaceholder.src}
    base={import.meta.env.BASE_URL}
  />
</BaseLayout>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');

  if (carousel) {
    const images: string[] = JSON.parse(carousel.dataset.images ?? '[]');
    const tiles = Array.from(carousel.querySelectorAll<HTMLImageElement>('[data-tile] img'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    const counter = carousel.querySelector<HTMLElement>('[data-carousel-counter]');
    const previous = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const maxStart = Math.max(0, images.length - tiles.length);
    let start = 0;

    const show = (index: number) => {
      if (images.length === 0 || tiles.length === 0) return;

      start = Math.min(Math.max(index, 0), maxStart);

      tiles.forEach((image, tileIndex) => {
        image.src = images[(start + tileIndex) % images.length];
      });

      dots.forEach((dot, dotIndex) => {
        dot.setAttribute('aria-current', dotIndex === start ? 'true' : 'false');
        dot.disabled = dotIndex > maxStart;
      });

      if (counter) {
        counter.textContent = `${start + 1}–${start + tiles.length} / ${images.length}`;
      }
    };

    previous?.addEventListener('click', () => show(start - 1));
    next?.addEventListener('click', () => show(start + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => show(index)));

    carousel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(start - 1);
      if (event.key === 'ArrowRight') show(start + 1);
    });

    show(0);
  }
</script>
