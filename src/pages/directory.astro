---
import BaseLayout from '../layouts/BaseLayout.astro';
import DirectoryView from '../components/mui/views/DirectoryView';
import directoryData from '../data/directory.json';
import type { DirectoryData } from '../data/types';
import layoutPlaceholder from '../images/directory-layout-placeholder.svg';

const directory = directoryData as DirectoryData;
---

<BaseLayout
  title="Directory"
  description="Building layout, room locations, and visitor directions for the City Health Office Annex."
>
  <DirectoryView directory={directory} layoutPlaceholder={layoutPlaceholder.src} />
</BaseLayout>
