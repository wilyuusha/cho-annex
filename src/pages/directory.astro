---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import EntryCard from '../components/EntryCard.astro';
import LastUpdated from '../components/LastUpdated.astro';
import directoryData from '../data/directory.json';
import type { DirectoryData } from '../data/types';

const directory = directoryData as DirectoryData;
---

<BaseLayout
  title="Directory"
  description="Building layout, room locations, and visitor directions for the City Health Office Annex."
>
  <header class="page-header">
    <p class="eyebrow">Find your way</p>
    <h1>Directory</h1>
    <p class="lead">
      Building layout, departments, room locations, and visitor directions. Room assignments may change.
    </p>
    <LastUpdated updated={directory.lastUpdated} />
  </header>

  {
    directory.visitorNotes.length > 0 && (
      <div class="notice" role="note">
        <p><strong>Visitor directions</strong></p>
        <ul>
          {directory.visitorNotes.map((note) => <li>{note}</li>)}
        </ul>
      </div>
    )
  }

  <section class="section" aria-labelledby="rooms-heading">
    <div class="section__header">
      <div>
        <h2 id="rooms-heading">Rooms and departments</h2>
      </div>
    </div>
    {
      directory.rooms.length > 0 ? (
        <div class="card-grid">
          {directory.rooms.map((room) => (
            <EntryCard
              title={room.name}
              meta={[
                ...(room.floor ? [{ label: 'Floor', value: room.floor }] : []),
                ...(room.location ? [{ label: 'Location', value: room.location }] : []),
              ]}
              details={[
                ...(room.services ?? []).map((service) => `Service: ${service}`),
                ...(room.notes ?? []),
              ]}
              updated={room.updated}
            />
          ))}
        </div>
      ) : (
        <EmptyState
          title="No room information published yet"
          message="Verified room locations and department details will appear here once confirmed."
        />
      )
    }
  </section>
</BaseLayout>
