---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchedulesView from '../components/mui/views/SchedulesView';
import schedulesData from '../data/schedules.json';
import type { SchedulesData } from '../data/types';

const schedules = schedulesData as SchedulesData;
---

<BaseLayout
  title="Schedules"
  description="Published schedules for the City Health Office Annex, including Animal Bite Treatment Center (ABTC), YAKAP, service availability, and operating hours."
>
  <SchedulesView schedules={schedules} base={import.meta.env.BASE_URL} />
</BaseLayout>
